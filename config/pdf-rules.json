{
  "tables": [
    {
      "name": "招商银行信用卡",
      "category": "信用卡交易",
      "source": "bank-cmb",
      "documentPattern": "招商银行.*信用卡.*对账单",
      "columns": [
        { "field": "tradeDate", "header": "^交易日期?$", "offset": -6 },
        { "field": "bookDate", "header": "^记账日期?$", "offset": -6 },
        { "field": "description", "header": "^交易摘要$", "offset": -6 },
        { "field": "amount", "header": "^(?:人民币|美元)金额$", "offset": -24 },
        { "field": "cardSuffix", "header": "^卡号(?:末|后)四位$", "fromPreviousRight": true, "offset": 8 },
        { "field": "ignore", "fromPreviousRight": true, "offset": 8 }
      ],
      "datePattern": "^(?:[0-9]{4}[-/.年])?[0-9]{1,2}[-/.月][0-9]{1,2}日?$",
      "statementDate": {
        "label": "^(?:本期)?账单日(?:期)?(?:[\\s：:]|$)",
        "monthInTitle": "(?<year>[0-9]{4})年\\s*(?<month>[0-9]{1,2})月",
        "lookahead": 4
      },
      "amount": {
        "pattern": "^(?<amount>[+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)\\.[0-9]{2})$",
        "currencyByHeader": { "人民币金额": "CNY", "美元金额": "USD" },
        "positiveDirection": "out"
      },
      "account": { "label": "招商银行信用卡", "suffixPattern": "^[0-9]{4}$" },
      "sections": ["还款", "分期", "退款", "消费", "费用", "利息", "取现", "其他", "调整"],
      "rules": [
        { "section": "分期", "date": "bookDate" },
        { "description": "^(?:消费|账单|现金)分期", "date": "bookDate" },
        { "section": "还款", "event": "transfer" },
        { "description": "^(?:自动|信用卡)?还款", "event": "transfer" },
        { "section": "退款", "direction": "in", "event": "refund" }
      ]
    },
    {
      "name": "中信银行信用卡",
      "category": "信用卡交易",
      "source": "bank-citic",
      "documentPattern": "中信银行信用卡(?:对账单|电子账单|[”\"]?微信公众号|\\(个人卡\\)领用合约)",
      "columns": [
        { "field": "tradeDate", "header": "^交易日(?:期)?$", "offset": -6 },
        { "field": "bookDate", "header": "^(?:银行)?记账日(?:期)?$", "offset": -6 },
        { "field": "cardSuffix", "header": "^卡号(?:后|末)四位$", "offset": -6 },
        { "field": "description", "header": "^交易描述$", "offset": -48 },
        { "field": "originalAmount", "header": "^交易货币/金额$", "offset": -2 },
        { "field": "amount", "header": "^记账货币/金额$", "offset": -2 }
      ],
      "datePattern": "^(?:[0-9]{8}|[0-9]{4}[-/][0-9]{1,2}[-/][0-9]{1,2})$",
      "descriptionWindow": { "maxDistance": 22, "baselineOffset": 2, "pageCarryDistance": 14 },
      "amount": {
        "pattern": "^(?<currency>[A-Z]{3})(?<amount>[+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)\\.[0-9]{2})$",
        "positiveDirection": "out"
      },
      "account": { "label": "中信银行信用卡", "suffixPattern": "^[0-9]{4}$" },
      "rules": [
        { "description": "^(?:消费|账单|现金)?分期", "date": "bookDate" },
        { "description": "^(?:自动|自助|多渠道|支付宝|网银|网联|银联|本行|跨行|信用卡)?还款", "direction": "in", "event": "transfer" },
        { "description": "返现|返利|奖励|利息返还", "direction": "in", "event": "income" },
        { "direction": "in", "event": "refund" }
      ]
    }
  ],
  "fallback": {
    "ignorePattern": "交易日期|摘要|金额|余额|第\\s*[0-9]+\\s*页|共\\s*[0-9]+\\s*页|statement",
    "amountPattern": "-?[0-9,]+\\.[0-9]{2}",
    "outPattern": "借方|支出|取出",
    "inPattern": "贷方|收入|存入|工资|薪|salary",
    "transferPattern": "还款|转账|充值|提现",
    "currency": "CNY",
    "category": "PDF银行流水"
  }
}
